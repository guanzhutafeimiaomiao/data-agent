# ---- 模型：千问（阿里云百炼 / DashScope 的 OpenAI 兼容端点）----
# 免费额度领取：https://bailian.console.aliyun.com/  -> API-KEY 管理
INSIGHT_MODEL_PROVIDER=qwen
INSIGHT_MODEL_NAME=qwen3.7-max
INSIGHT_MODEL_BASE_URL=
INSIGHT_API_KEY=sk-xxxxxxxx

# 便宜的小模型跑 plan / critic，强模型只跑 sql_gen（省 token 的关键）
INSIGHT_FAST_MODEL_NAME=qwen-turbo

# ---- 数据库 ----
INSIGHT_DB_PATH=data/demo.sqlite

# ---- 运行 ----
INSIGHT_MAX_REPAIR=2
INSIGHT_ROW_LIMIT=200
INSIGHT_QUERY_TIMEOUT_MS=8000
# 私有化部署单次调用常常 50s+，超时给宽一点，否则会频繁误杀
INSIGHT_LLM_TIMEOUT_S=180
# 1 = 强制用确定性实现（不花钱、可复现，适合跑测试和评测基线）
INSIGHT_FAKE_LLM=0
# 空结果时反查"问题里的实体是否真的存在"
INSIGHT_ENABLE_GROUNDING=1

# ---- 多轮会话 ----
INSIGHT_CHECKPOINT_PATH=data/checkpoints.db
INSIGHT_HISTORY_TURNS=6
INSIGHT_ENABLE_REWRITE=1

# ---- 口径记忆（跨会话的知识库）----
INSIGHT_STORE_PATH=data/store.db
INSIGHT_ENABLE_SEMANTICS=1

# ---- 人工审批（高风险查询执行前暂停）----
INSIGHT_APPROVAL_ENABLED=1

# ---- 可观测 ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insight-agent
